{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/aps/solver-capabilities.schema.json",
  "title": "SolverCapabilities v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "engine",
    "version",
    "constraints",
    "max_operations",
    "can_prove_optimal",
    "can_prove_infeasible",
    "supports_cancel"
  ],
  "properties": {
    "engine": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "constraints": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "H01",
          "H02",
          "H03",
          "H04",
          "H05",
          "H06",
          "H07",
          "H08"
        ]
      }
    },
    "max_operations": {
      "type": "integer",
      "minimum": 1
    },
    "can_prove_optimal": {
      "type": "boolean"
    },
    "can_prove_infeasible": {
      "type": "boolean"
    },
    "supports_cancel": {
      "type": "boolean"
    }
  }
}
