{
  "version": "1.0.0",
  "note": "单一来源：实验室艺术化系统的语义规则。运行时（TypeScript）与构建期审计脚本（Node）都读这一份，避免两套规则漂移。规则条目来自对 lab/design/assets 全部 475 个 GLB 的材质名/节点名实测统计（见 lab/design/assets/MODEL-STRUCTURE-AUDIT.json）。",
  "roles": {
    "shell": "设备外壳/机罩：喷涂金属板（cream/blue/enamel/paint 等），艺术化后为冷银灰，可选择性半透明",
    "frame": "结构钢构/机架：steel，保持清晰机械轮廓，不做透明",
    "graphite": "深色金属结构件：dark/charcoal/graphite，用于压出层次",
    "machined": "精密加工金属件：cast/metal，主轴、台面、导轨等内部机构",
    "glazing": "玻璃/透明件：观察窗、防护罩、门窗玻璃",
    "rubber": "橡胶/密封/轮胎",
    "hazard": "安全色：黄/绿警示涂装",
    "accent": "强调色：橙/红/琥珀（按钮、护罩、危险件）",
    "emissive": "自发光件：glow/light/screen（状态灯、屏幕、灯具）",
    "fluid": "液体/水/冷却液",
    "polymer": "塑料/复合/软性材料：soft/carcass/surface/white/grey",
    "floor": "地面与基础：floor/concrete/epoxy/deck",
    "organic": "木材等自然材料：wood",
    "metalWarm": "有色金属：copper/brass",
    "consumable": "工件/被加工物：candy/choc/kraft 等",
    "skin": "人形标尺的皮肤材质（机器人模型）",
    "unknown": "未命中规则：审计会列出，必须显式扩展规则而不是静默兜底"
  },
  "unlitRiskRoles": [
    "emissive"
  ],
  "transparencyCandidates": [
    "glazing",
    "shell"
  ],
