  "transparencyPolicy": {
    "note": "哪些角色/部件组允许进入半透明外壳层（模式 B/C）。顺序即优先级：先命中先用。设备内部机构永远不进透明层，保证内部结构可见。",
    "rules": [
      {
        "kind": "group",
        "match": "roof",
        "scope": "structure",
        "alpha": 0.1
      },
      {
        "kind": "group",
        "match": "structure",
        "scope": "structure",
        "alpha": 0.14
      },
