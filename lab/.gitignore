# 实验室构建产物与依赖（不纳入版本库；CI 每次自动生成）

node_modules/
dist/
.vite/
artifacts/

# sync-engine 生成物：真正的来源是 aps/rust（wasm/胶水）与 aps/mock（数据）
# 这些文件由 `npm run sync` 自动生成，因此不入库，避免“多份副本互相漂移”。
public/wasm/
public/mock/
public/engine-manifest.json
src/vendor/aps-worker.js

# 本地缓存
node_modules/.lab-smoke/
*.tsbuildinfo

# sync-mapf 生成物（来源：mapf/rust 与 mapf/mock）
src/vendor/mapf-worker.js
public/mapf-manifest.json

# sync-agv 生成物（来源：agv/rust 与 agv/mock）
src/vendor/agv-worker.js
public/agv-manifest.json

# sync-visual-assets 生成物（来源：lab/design/assets，CC0 1.0，原样复制且不修改源文件）
public/models/
