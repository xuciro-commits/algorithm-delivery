{
  "name": "algorithm-delivery-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Algorithm Delivery \u7edf\u4e00\u7b97\u6cd5\u5b9e\u9a8c\u5ba4\uff1a\u6d4f\u89c8\u5668\u5185 WASM \u8ba1\u7b97\u3001\u53ef\u89c6\u5316\u4e0e\u6027\u80fd\u8bc4\u6d4b",
  "scripts": {
    "sync": "node scripts/sync-engine.mjs && node scripts/sync-mapf.mjs",
    "predev": "npm run sync",
    "dev": "vite",
    "prebuild": "npm run sync",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "prepreview": "npm run sync",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:dist",
    "test:core": "node scripts/smoke-lab.mjs",
    "test:imports": "node scripts/test-imports.mjs",
    "test:runner": "node scripts/test-runner-lifecycle.mjs",
    "test:render": "node scripts/test-render.mjs",
    "test:dist": "node scripts/check-dist.mjs",
    "test:pages": "node scripts/check-pages.mjs",
    "test:all": "npm run build && npm run test:imports && npm run test:core && npm run test:runner && npm run test:render && npm run test:dist && npm run test:pages",
    "build:all": "bash scripts/build-all.sh",
    "sync:aps": "node scripts/sync-engine.mjs",
    "sync:mapf": "node scripts/sync-mapf.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.51.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
